@{
    ViewData["Title"] = "Contact Us";
}

<div class="hero" style="min-height: auto; padding: 3rem 1rem 1.5rem;">
    <div class="hero-content" style="max-width: 1000px; width: 100%;">
        <h1 class="hero-title">Contact Us</h1>

        <div class="verse-box text-start" style="max-width: 100%;">
            <p style="font-size: 1.1rem; color: #ddd; margin-bottom: 0;">
                Questions, privacy requests, or just want to talk it through before booking?
                Reach England Technologies by phone or email.
            </p>
        </div>
    </div>
</div>

<section class="container pb-5" style="max-width: 1000px;">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100"><div class="card-body" style="color: #ddd;">
                <h2 class="h4" style="color: #00bfff;">Phone</h2>
                <p><a href="tel:+19042580217" style="color: #00bfff;">904-258-0217</a></p>
                <p class="mb-0" style="color: #aaa;">Business line for England Technologies. Call or text.</p>
            </div></div>
        </div>
        <div class="col-md-6">
            <div class="card h-100"><div class="card-body" style="color: #ddd;">
                <h2 class="h4" style="color: #00bfff;">Email</h2>
                <p style="overflow-wrap: anywhere;"><a href="mailto:contact.techsupport@englandtechnologies.net" style="color: #00bfff;">contact.techsupport@englandtechnologies.net</a></p>
                <p class="mb-0" style="color: #aaa;">Include your name and a phone number so I can follow up.</p>
            </div></div>
        </div>
        <div class="col-12">
            <div class="card"><div class="card-body" style="color: #ddd;">
                <h2 class="h4" style="color: #00bfff;">Ready to book?</h2>
                <p>Pick a day and time that works for you on the booking page.</p>
                <a class="btn btn-outline-info" style="color: var(--et-accent, #00bfff) !important;" href="/contact">Book Online</a>
            </div></div>
        </div>
    </div>
</section>
