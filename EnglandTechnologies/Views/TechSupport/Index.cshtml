@{
    ViewData["Title"] = "Tech Support";
}

<div class="hero" style="min-height: auto; padding: 4rem 1rem 3rem;">
    <div class="hero-content" style="max-width: 1200px; width: 100%;">
        <h1 class="hero-title">Tech support that actually gets it fixed.</h1>

        <div class="verse-box text-start" style="max-width: 100%;">
            <p style="font-size: 1.15rem; color: #ddd; margin-bottom: 1.5rem;">
                England Technologies provides straightforward, honest help with the everyday
                computer and network problems that slow you down. No jargon, no runaround.
            </p>
            <p style="font-size: 1.15rem; color: #ddd; margin-bottom: 1.5rem;">
                <strong style="color: #00bfff;">I come to you.</strong> I meet with you however you prefer,
                whether virtually or in person, to help with your questions and concerns.
            </p>
            <p style="font-size: 1rem; color: #aaa; margin-bottom: 1.5rem;">
                Based in the Jacksonville, FL area. No travel fee within 25 miles of ZIP code 32259;
                remote sessions are available too.
            </p>

            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <h4 style="color: #00bfff;">Clear plan first</h4>
                    <div style="color: #aaa; font-size: 0.95rem;">You know the problem, the approach and the cost before any work begins.</div>
                </div>
                <div class="col-md-4">
                    <h4 style="color: #00bfff;">Plain English</h4>
                    <div style="color: #aaa; font-size: 0.95rem;">You will understand what was wrong and what was done to fix it.</div>
                </div>
                <div class="col-md-4">
                    <h4 style="color: #00bfff;">Private by default</h4>
                    <div style="color: #aaa; font-size: 0.95rem;">Your files and data are treated as confidential.</div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-center flex-wrap mt-4">
                <a class="btn btn-outline-info" style="color: var(--et-accent, #00bfff) !important;" href="/contact">Book Online</a>
                <a class="btn btn-outline-light" style="color: var(--et-btn-text, #e0e0e0) !important;" href="/contactus">Contact Us</a>
                <a class="btn btn-outline-light" style="color: var(--et-btn-text, #e0e0e0) !important;" href="/services">See Services<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align: -0.125em; margin-left: .35rem;"><path d="M9.5 2H14v4.5M14 2 7.5 8.5"/><path d="M12 9.5V13a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3.5"/></svg><span class="visually-hidden"> (opens the Services page)</span></a>
            </div>
        </div>
    </div>
</div>

<section class="container py-5">
    <h2 class="text-center mb-4" style="color: #00bfff;">Why England Technologies</h2>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100"><div class="card-body" style="color: #ddd;">
                <h3 class="h5" style="color: #00bfff;">Hands-on experience</h3>
                <p class="mb-0">I run and maintain my own multi-server lab, so I work with real systems, not just theory.</p>
            </div></div>
        </div>
        <div class="col-md-6">
            <div class="card h-100"><div class="card-body" style="color: #ddd;">
                <h3 class="h5" style="color: #00bfff;">Local and accountable</h3>
                <p class="mb-0">You are working directly with the person doing the job, from first message to final check.</p>
            </div></div>
        </div>
        <div class="col-12">
            <div class="card h-100"><div class="card-body" style="color: #ddd;">
                <h3 class="h5" style="color: #00bfff;">Certifications</h3>
                <ul class="mb-0">
                    <li>MTA Certificate in Cybersecurity</li>
                    <li>Networking Fundamentals Certificate in Cybersecurity</li>
                    <li>Windows&reg; Operating System Fundamentals in Cybersecurity</li>
                    <li>Security Fundamentals Certificate in Cybersecurity</li>
                    <li>CompTIA ITF+</li>
                </ul>
            </div></div>
        </div>
    </div>
</section>

<section class="container py-5">
    <h2 class="text-center mb-2" style="color: #00bfff;">How it works</h2>
    <p class="text-center mb-4" style="color: #aaa;">Getting help is three steps.</p>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body" style="color: #ddd;">
                <h3 class="h5" style="color: #00bfff;">1. Reach out</h3>
                <p class="mb-0">Book a time online, or call 904-258-0217, and tell me what is going on and what device or system is involved.</p>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body" style="color: #ddd;">
                <h3 class="h5" style="color: #00bfff;">2. Get a clear plan</h3>
                <p class="mb-0">I explain what I think the problem is, what it will take, and the cost before any work begins.</p>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body" style="color: #ddd;">
                <h3 class="h5" style="color: #00bfff;">3. Problem solved</h3>
                <p class="mb-0">I do the work, walk you through what changed, and make sure everything runs the way it should.</p>
            </div></div>
        </div>
    </div>
</section>

<section id="rates" class="container py-5" style="scroll-margin-top: 1rem;">
    <h2 class="text-center mb-2" style="color: #00bfff;">Rates and Policies</h2>
    <p class="text-center mx-auto mb-2" style="color: #aaa; max-width: 800px;">
        Service prices above are flat. The price is the same whether the service is done on-site or remotely, and it covers the time listed for that service.
    </p>
    <p class="text-center mx-auto mb-2" style="color: #aaa; max-width: 800px;">
        If a session runs past its listed time, the extra time is billed at $50 per hour in 15-minute increments. I will let you know before continuing past the listed time.
    </p>
    <p class="text-center mx-auto mb-4" style="color: #aaa; max-width: 800px;">
        Work that is not one of the listed services is billed hourly. Full details are in the
        <a href="/legal#terms" style="color: #00bfff;">Terms and Conditions</a> and
        <a href="/legal#privacy" style="color: #00bfff;">Privacy Policy</a>.
    </p>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100"><div class="card-body" style="color: #ddd;">
                <h3 class="h5" style="color: #00bfff;">Hourly rates</h3>
                <ul class="mb-0">
                    <li>First hour, on-site: $65</li>
                    <li>First hour, remote: $55</li>
                    <li>Each additional hour: $50, billed in 15-minute increments</li>
                    <li>Work under one hour: $1 per minute, 30-minute minimum ($30)</li>
                    <li>Each additional drive for Secure Drive Wipe: $15</li>
                </ul>
            </div></div>
        </div>
        <div class="col-md-6">
            <div class="card h-100"><div class="card-body" style="color: #ddd;">
                <h3 class="h5" style="color: #00bfff;">Travel</h3>
                <p>No travel fee within 25 miles of ZIP code 32259-3268 (one way).</p>
                <p class="mb-0">Beyond that, $1.50 per mile past the 25-mile radius. The fee is based on the one-way driving distance from that ZIP code to your address.</p>
            </div></div>
        </div>
        <div class="col-12">
            <div class="card h-100"><div class="card-body" style="color: #ddd;">
                <h3 class="h5" style="color: #00bfff;">Policies</h3>
                <ul class="mb-0">
                    <li>You are responsible for supplying all hardware and supplies. Installation fees apply to labor and expertise only.</li>
                    <li>No extra fee for same-day appointments or after-hours appointments.</li>
                    <li>Data recovery starts with a 30-minute evaluation. If you do not continue, the evaluation fee is the only fee. If you approve a full recovery, the evaluation fee is included in the recovery price and is not added.</li>
                    <li>Recovery results depend on the condition of your drive. The evaluation shows what is realistic before you commit.</li>
                    <li>You choose your own times.</li>
                    <li>The times listed are estimates based on experience. Some situations may take longer and others may be shorter, depending on the circumstances.</li>
                    <li>Because times are estimates and can vary, I will see as many customers as I can on the day they schedule their appointment. If I am unable to make it that day, I will contact you to arrange another day.</li>
                </ul>
            </div></div>
        </div>
    </div>
</section>


<section class="container py-5 text-center">
    <h2 class="mb-3" style="color: #00bfff;">Ready to get started?</h2>
    <p style="color: #ddd;">Pick a <a href="/services">service</a> and book a time that works for you, or call and describe your issue and I will get back to you with next steps.</p>
    <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a class="btn btn-outline-info" style="color: var(--et-accent, #00bfff) !important;" href="/contact">Book Online</a>
        <a class="btn btn-outline-light" style="color: var(--et-btn-text, #e0e0e0) !important;" href="/contactus">Contact Us</a>
    </div>
</section>
