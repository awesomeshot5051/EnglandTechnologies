@{
    ViewData["Title"] = "Request Help";
    var bookingUrl = (string?)ViewData["BookingUrl"];
    var selectedService = (string?)ViewData["SelectedService"];
}

<div class="hero" style="min-height: auto; padding: 2rem 1rem 1rem;">
    <div class="hero-content" style="max-width: 1000px; width: 100%;">
        <h1 class="hero-title" style="font-size: clamp(1.4rem, 3vw, 2rem); margin-bottom: 0;">Request Help@(string.IsNullOrEmpty(selectedService) ? "" : $" with {selectedService}")</h1>
    </div>
</div>

<section class="container pb-5">
    @if (string.IsNullOrWhiteSpace(bookingUrl))
    {
        <p class="text-center" style="color: #ddd;">Booking is temporarily unavailable.</p>
    }
    else
    {
        <div class="card">
            <iframe src="@bookingUrl" title="Schedule a visit"
                    style="width: 100%; height: 900px; border: 0; border-radius: 8px; background: #fff;"></iframe>
        </div>
        <p class="text-center mt-3" style="color: #aaa; font-size: 0.95rem;">
            Having trouble with the form?
            <a href="@bookingUrl" target="_blank" rel="noopener">Open the booking page in its own tab.</a>
        </p>
        <p class="text-center" style="color: #ddd;">
            Prefer to talk it through? Call <a href="tel:+19042580217" style="color: #00bfff;">904-258-0217</a> or see the <a href="/contactus" style="color: #00bfff;">Contact page</a>.
        </p>
    }
</section>
