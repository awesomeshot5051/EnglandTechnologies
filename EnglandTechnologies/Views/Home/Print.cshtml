@{
ViewData["Title"] = "Live Fabricator Feed";
Layout = null; // Bypasses the global navbar and footer for a true full-screen canvas
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/etico-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/etico.svg" />
    <title>@ViewData["Title"]</title>
    <style>
        /* --- Global Styles & Layout (Inlined from site.css) --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            width: 100%;
            height: 100%;
            background-color: #0a0a0a;
            overflow: hidden; /* Keeping hidden to preserve full-screen canvas look */
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-weight: 600;
            color: #e0e0e0;
            line-height: 1.6;
        }

        /* --- Isolated Viewport Center Wrapper --- */
        .page-viewport-wrapper {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 1;
        }

        /* --- Enhanced Background Pattern --- */
        .bg-pattern {
            position: fixed;
            top: -10%; /* Extra padding prevents edges from showing during rotation */
            left: -10%;
            width: 120%;
            height: 120%;
            z-index: 0;
            pointer-events: none;
        }

        .bg-pattern::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image:
                radial-gradient(circle at 20% 30%, rgba(59, 130, 246, 0.25) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(147, 51, 234, 0.25) 0%, transparent 50%),
                radial-gradient(circle at 40% 80%, rgba(239, 68, 68, 0.20) 0%, transparent 60%),
                linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 100% 100%, 40px 40px, 40px 40px;
            animation: float 25s ease-in-out infinite;
            opacity: 0.85;
        }

        @@keyframes float {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            50% { transform: translate(15px, 20px) rotate(1deg); }
        }

        /* --- Canvas Layout Structure --- */
        .fullscreen-stream-container {
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .fullscreen-stream-container img {
            width: 100%;
            height: 100%;
            object-fit: contain; /* Preserves your crisp 16:9 aspect ratio without stretching the geometry */
            display: block;
        }

        /* --- Custom UI Integration for Error Handling --- */
        .container {
            position: relative;
            z-index: 2;
            display: none; /* Hidden unless stream fails */
            width: 100%;
            max-width: 700px;
            padding: 2rem;
        }

        /* Customizing your .verse-box structure for the error styling */
        .error-panel {
            width: 100%;
            padding: 2.5rem;
            background: rgba(30, 30, 45, 0.75);
            border-radius: 16px;
            border: 1px solid rgba(0, 191, 255, 0.25);
            backdrop-filter: blur(12px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            animation: pulse 4s infinite ease-in-out;
            text-align: center;
        }

        @@keyframes pulse {
            0%, 100% { opacity: 0.95; }
            50% { opacity: 1; }
        }

        .error-title {
            font-size: clamp(2.2rem, 5vw, 3.5rem);
            color: #00bfff;
            margin-bottom: 2rem;
            text-shadow: 0 0 15px #00bfff;
            font-weight: 700;
        }

        .error-text {
            font-size: 1.25rem;
            color: #ddd;
            line-height: 1.75;
            font-style: italic;
            white-space: pre-line; /* Direct line break translation for \n styling */
        }
    </style>
</head>
<body>

<div class="bg-pattern"></div>

<div class="page-viewport-wrapper">

    <div id="streamContainer" class="fullscreen-stream-container">
        <img id="streamImage" src="https://cam.englandtechnologies.net/?action=stream" alt="Live Printer Feed">
    </div>

    <div id="errorContainer" class="container">
        <div class="error-panel">
            <h1 class="error-title">Hmm...</h1>
            <div class="error-text">Doesn't seem like there's anything printing at the moment.&#10;Check back at a later time.</div>
            <p class="error-text"> Return <a href="/Docs">Home</a></p>
        </div>
    </div>

</div>

<script>
    // Safely look up the image element once the DOM loads
    const streamImg = document.getElementById('streamImage');

    if (streamImg) {
        // Modern standard event registration
        streamImg.addEventListener('error', function handleStreamError() {
            // Drop the faulty stream canvas entirely
            document.getElementById('streamContainer').style.display = 'none';

            // Expose the custom panel matching your layout design ecosystem
            document.getElementById('errorContainer').style.display = 'block';
        });
    }
</script>

</body>
</html>